# Copy to .env (git-ignored) and fill in. Loaded automatically by `./gradlew run`.
MQTT_BROKER_URL=tcp://<host>:1883
MQTT_USERNAME=
MQTT_PASSWORD=
# Password of the staff user `admin`, applied only when the user table is empty (default: admin).
ADMIN_PASSWORD=
# Passenger assistant (POST /api/v1/assistant/ask)
ANTHROPIC_API_KEY=
SBB_TWIN_URL=http://127.0.0.1:8787
# Passenger voice app (GET /api/voice/session): ElevenLabs key + conversational agent id
ELEVENLABS_API_KEY=
PASSENGER_AGENT_ID=
# Push notifications. Web Push works with no setup (VAPID keys generated and kept in SQLite). Android app push needs the
# Firebase service account JSON (raw or base64). Optional: pin the VAPID keys (base64url) and the contact subject.
FCM_SERVICE_ACCOUNT_JSON=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.org
