# Copy to .env (git-ignored) and fill in. Loaded automatically by `./gradlew run`.
MQTT_BROKER_URL=tcp://<host>:1883
MQTT_USERNAME=
MQTT_PASSWORD=
# Password of the staff user `admin`, applied only when the user table is empty (default: admin).
ADMIN_PASSWORD=
# Passenger assistant (POST /api/v1/assistant/ask)
ANTHROPIC_API_KEY=
SBB_TWIN_URL=http://127.0.0.1:8787
# Passenger voice app (GET /api/voice/session): ElevenLabs key + conversational agent id
ELEVENLABS_API_KEY=
PASSENGER_AGENT_ID=

# Trip Watch is opt-in on the server. With neither issuer configured, the watch works in the web app.
WALLET_ENABLED=false
# Set the public HTTPS origin for either Wallet issuer. The watch database defaults to DB_PATH + .wallet.sqlite.
WALLET_PUBLIC_BASE_URL=
WALLET_DB_PATH=
WALLET_APPLE_PASS_TYPE_ID=
WALLET_APPLE_TEAM_ID=
WALLET_APPLE_P12=
WALLET_APPLE_P12_PASSWORD=
WALLET_APPLE_WWDR_CERT=
WALLET_GOOGLE_CLASS_ID=
GOOGLE_APPLICATION_CREDENTIALS=
