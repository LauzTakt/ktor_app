{
  "name": "twin-assistant-client",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Passenger voice assistant (ex sbb-client): map, live trains, cards, ElevenLabs voice agent. Served by ktor_app at /assistant/.",
  "scripts": {
    "dev": "vite",
    "build:ui": "tailwindcss -i rail-ui.css -o ../src/main/resources/static/vendor/daisyui.css --minify",
    "build": "vite build",
    "test": "node --test tests/*.test.mjs",
    "agent": "node scripts/create-agent.mjs",
    "agent:chat": "node scripts/agent-chat.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@elevenlabs/client": "^1.37.1",
    "lucide-react": "^1.77.0",
    "maplibre-gl": "^6.19.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/cli": "4.3.5",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "daisyui": "5.8.2",
    "tailwindcss": "4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
